class Main{
    public static void main(String[] args){
        int[] arr = {1,4,7,8,10,37};
        int target = 56;
        System.out.print(ceiling(arr,target));
    }
    static int ceiling(int[] arr,int target){
        int start = 0;
        int end = arr.length - 1;
        if(target > arr[arr.length]){      //IF THE TARGET IS GREATER THAN ALL NUMBERS IN ARRAY IT RETURNS -1 THIS IMPLIES THERE IS NO CEILING NUMBER
            return -1;
}
        while(start <= end){
            int mid = start + (end - start)/2;
            if(arr[mid] == target){
                return mid;
            }
            else if(arr[mid] < target){
                start = mid + 1;
            }
            else{
                end = mid - 1;
            }
        }
        return start; 

    }
    
}
